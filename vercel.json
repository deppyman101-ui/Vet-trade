{
  "rewrites": [
    {
      "source": "/join",
      "destination": "/join.html"
    },
    {
      "source": "/newaddy",
      "destination": "/api/newaddy-page-v2?page=public"
    },
    {
      "source": "/newaddy/",
      "destination": "/api/newaddy-page-v2?page=public"
    },
    {
      "source": "/newaddy/admin",
      "destination": "/api/newaddy-page-v2?page=admin"
    },
    {
      "source": "/newaddy/admin/",
      "destination": "/api/newaddy-page-v2?page=admin"
    },
    {
      "source": "/newaddy/payment",
      "destination": "/nextkey/payment-success.html"
    },
    {
      "source": "/newaddy/payment/",
      "destination": "/nextkey/payment-success.html"
    },
    {
      "source": "/newaddy/:path*",
      "destination": "/nextkey/:path*"
    }
  ]
}
